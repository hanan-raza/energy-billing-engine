<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- With TreatWarningsAsErrors a public member without a doc comment (CS1591) fails the build,
         so the public API and the OpenAPI document cannot drift into being undocumented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
